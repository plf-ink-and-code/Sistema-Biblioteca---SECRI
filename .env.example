SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_de_app
NOTIFY_EMAILS=gestor@exemplo.com
NOTIFY_COOLDOWN_DAYS=7
SMTP_TIMEOUT=10

# Autenticação (admin único). Troque a senha antes de usar de verdade!
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
AUTH_SECRET=troque-por-um-valor-aleatorio-longo

# Rate limiting do login
LOGIN_MAX_ATTEMPTS=5
LOGIN_COOLDOWN_SECS=300

# Expiração de sessão (horas)
SESSION_MAX_AGE_HOURS=8

# Intervalo do job de verificação de atrasos (segundos)
OVERDUE_CHECK_INTERVAL=3600

# Backup automático do banco
BACKUP_INTERVAL=86400
BACKUP_KEEP=7

# Envio off-site do backup para o Google Drive (opcional, opt-in).
# Só ativa se GDRIVE_CREDENTIALS_FILE e GDRIVE_FOLDER_ID estiverem definidos.
# Ver docs/GOOGLE-DRIVE-BACKUP.md para gerar a credencial (Service Account).
# GDRIVE_CREDENTIALS_FILE=/run/secrets/gdrive.json
# GDRIVE_FOLDER_ID=id-da-pasta-compartilhada-com-a-service-account
# GDRIVE_KEEP=30
